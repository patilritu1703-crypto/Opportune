# OpporTune environment variables
# The app runs fully without any of these — they're optional overrides.

# Port the Node server listens on (Cloud Run injects this automatically)
PORT=8080

# Optional: only needed if you wire the AI Opportunity Assistant to a real
# LLM API instead of the built-in rule-based assistant. Not required to run
# or deploy the app.
# ANTHROPIC_API_KEY=
